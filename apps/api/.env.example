# ---- Server -------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed by CORS (Expo web during development)
CORS_ORIGINS=http://localhost:8081
# Set to the number of reverse proxies in front of the API in production
TRUST_PROXY=0

# ---- Database -----------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/mindbridge

# ---- Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ---- Field encryption (32 random bytes, base64) --------------------------
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# ---- AI provider ---------------------------------------------------------
# rule-based | anthropic | openai-compatible
AI_PROVIDER=rule-based
AI_API_KEY=
# anthropic: e.g. claude-sonnet-4-5 ; openai-compatible: your model id
AI_MODEL=
# Only for openai-compatible providers (OpenAI, Groq, Together, local vLLM, ...)
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=20000

# ---- Data retention --------------------------------------------------------
# Raw AI analysis records (aiInteractions) and safety events are deleted after N days
AI_INTERACTION_RETENTION_DAYS=30
SAFETY_EVENT_RETENTION_DAYS=90

# ---- Email (password reset). Leave SMTP_HOST empty to log reset links in development only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MindBridge AI <no-reply@example.com>"
# Deep link / web URL used in password reset emails
PASSWORD_RESET_URL=mindbridge://reset-password
